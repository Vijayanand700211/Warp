{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "flow_id": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": ["benign", "suspicious", "malicious"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "model_version": {
      "type": "string"
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "flow_id",
    "verdict",
    "confidence",
    "model_version",
    "latency_ms"
  ]
}
